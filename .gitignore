# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cloudflare / opennext
/.open-next/
/.wrangler/
/cloudflare-env.d.ts

# local tooling
/.firecrawl/
/.cursor/

# Competitor site dumps (keep curated PNGs only under design/reference-screenshots/)
/design/reference-screenshots/SiPhox Health.html
/design/reference-screenshots/SiPhox Health.pdf
/design/reference-screenshots/SiPhox Health_files/

# production
/build

# misc
.DS_Store
*.pem

# Local lab PDFs / extracted text may contain PII + health data
/Analitica*.pdf
/lib/extraction/fixtures/analitica*.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Local extract dumps / PII scratch (not fixtures under lib/)
/fixtures/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
